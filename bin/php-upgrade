#!/usr/bin/env bash
# Moves the whole JumPHP infrastructure to another PHP version, and checks it still works. Run it again for each
# new PHP (8.6, 8.7...): it finds the versions in use by itself.
#
#   bin/php-upgrade 8.5                  everything: versions, fixes, images, checks, the WebAssembly engine
#   bin/php-upgrade 8.5 --skip-wasm      not the WebAssembly engine (the longest part: ~25 min cold)
#   bin/php-upgrade 8.5 --check          nothing changed: only the checks, with the images as they are
#
# What it changes (JUMPHP_DIR: the JumPHP repository, default ../JumPHP):
#   playground  Dockerfile (dunglas/frankenphp:1-phpX), docker/tester (php:X-cli-bookworm), docs
#   JumPHP      docker/desktop (php:X-cli-bookworm), docker/relay (php:X-cli-alpine), docker/engine-wasm
#               (PHP_BRANCH=php-X.Y.Z, the newest patch release), README.md, AGENTS.md, docs/
#               (the TrueAsync runtime, docker/desktop-async, follows its own PHP: not touched)
#   the code    what PHP deprecates, fixed in place: (boolean) (integer) (double) (binary) casts,
#               ->setAccessible(true) (no effect since 8.1, deprecated in 8.5), imagedestroy(), curl_close(),
#               finfo_close(), xml_parser_free() (no-ops, deprecated in 8.5)
# Then it builds the images and runs every check: the playground's PHPUnit and PHPStan, `php -l` of all the
# code, the engine's tests, each game's `bin/jumphp test` (any "Deprecated" is a failure), and the WebAssembly
# engine with its runtime (bin/jumphp engine:build, runtime:build). It changes nothing in production and
# publishes nothing: the end tells what is left (a JumPHP release, the engine on the playground, the deploy).
set -euo pipefail

PLAYGROUND="$(cd "$(dirname "$0")/.." && pwd)"
JUMPHP="${JUMPHP_DIR:-$(cd "$PLAYGROUND/.." && pwd)/JumPHP}"
TARGET="${1:-}"
shift || true
SKIP_WASM=0
CHECK_ONLY=0
for arg in "$@"; do
  case "$arg" in
    --skip-wasm) SKIP_WASM=1 ;;
    --check) CHECK_ONLY=1 ;;
    *) echo "unknown option $arg" >&2; exit 2 ;;
  esac
done
[[ "$TARGET" =~ ^8\.[0-9]+$ ]] || { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[ -x "$JUMPHP/bin/jumphp" ] || { echo "no JumPHP repository in $JUMPHP (JUMPHP_DIR=...)" >&2; exit 2; }

say() { printf '\033[1;36m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m[!] %s\033[0m\n' "$*"; }
FAILED=()
check() { local name="$1"; shift; say "check: $name"; if "$@"; then echo "    ok"; else warn "FAILED: $name"; FAILED+=("$name"); fi; }

# the newest patch release of $TARGET (the WebAssembly engine is built from its tag)
say "PHP $TARGET: newest release"
docker pull -q "php:$TARGET-cli-bookworm" >/dev/null
FULL="$(docker run --rm "php:$TARGET-cli-bookworm" php -r 'echo PHP_VERSION;')"
echo "    $FULL"
OLD_GAMES="$(sed -nE 's/^FROM php:([0-9]+\.[0-9]+)-cli-bookworm.*/\1/p' "$JUMPHP/docker/desktop/Dockerfile")"
OLD_SITE="$(sed -nE 's/^FROM dunglas\/frankenphp:1-php([0-9]+\.[0-9]+).*/\1/p' "$PLAYGROUND/Dockerfile")"
echo "    now: the games $OLD_GAMES (desktop, browser, tester), the site $OLD_SITE"

if [ "$CHECK_ONLY" = 0 ]; then
  say "versions"
  # replace <regex> <replacement> <files...>: in place, says which files changed
  replace() {
    local from="$1" to="$2"; shift 2
    local f before
    for f in "$@"; do
      [ -f "$f" ] || continue
      before="$(md5sum < "$f")"
      perl -0pi -e "s/$from/$to/g" "$f"
      [ "$before" = "$(md5sum < "$f")" ] || echo "    $f"
    done
  }
  replace 'dunglas\/frankenphp:1-php[0-9.]+' "dunglas\/frankenphp:1-php$TARGET" "$PLAYGROUND/Dockerfile"
  replace 'php:[0-9.]+-cli-bookworm' "php:$TARGET-cli-bookworm" "$PLAYGROUND/docker/tester/Dockerfile" "$JUMPHP/docker/desktop/Dockerfile"
  replace 'php:[0-9.]+-cli-alpine' "php:$TARGET-cli-alpine" "$JUMPHP/docker/relay/Dockerfile"
  replace 'ARG PHP_BRANCH=\S+' "ARG PHP_BRANCH=php-$FULL" "$JUMPHP/docker/engine-wasm/Dockerfile"
  if [ -n "$OLD_GAMES" ] && [ "$OLD_GAMES" != "$TARGET" ]; then
    o="${OLD_GAMES//./\\.}"
    # the docs say which PHP runs the games (not the TrueAsync runtime's own PHP, written with ZTS)
    mapfile -t docs < <(cd "$JUMPHP" && ls README.md AGENTS.md docs/*.md games/*/AGENTS.md skeleton/AGENTS.md 2>/dev/null)
    replace "PHP $o(?! ZTS)\\b" "PHP $TARGET" "${docs[@]/#/$JUMPHP/}" "$PLAYGROUND/docker/tester/Dockerfile" \
      "$JUMPHP/docker/desktop/Dockerfile" "$JUMPHP/docker/engine-wasm/Dockerfile" \
      "$PLAYGROUND/content/docs/tests.md" "$PLAYGROUND/content/docs/en/tests.md"
    replace "PHP-$o\\.0" "php-$FULL" "$JUMPHP/docs/build.md"
    replace "runs $o, the browser $o" "runs $TARGET, the browser $TARGET" "$JUMPHP/AGENTS.md"
  fi

  say "code: what PHP $TARGET deprecates"
  mapfile -t sources < <(
    cd "$PLAYGROUND" && find src tests docker/tester -name '*.php' -printf "$PLAYGROUND/%p\n"
    cd "$JUMPHP" && find engine/src engine/tests engine/bootstrap games/*/src games/*/tests skeleton tools -name '*.php' -not -path '*/vendor/*' -printf "$JUMPHP/%p\n" 2>/dev/null
  )
  replace '\(boolean\)' '(bool)' "${sources[@]}"
  replace '\(integer\)' '(int)' "${sources[@]}"
  replace '\(double\)' '(float)' "${sources[@]}"
  replace '\(binary\)' '(string)' "${sources[@]}"
  replace '\n[ \t]*\$[\w>\-\[\]\x27"()]+->setAccessible\(\s*true\s*\);' '' "${sources[@]}"
  replace '\n[ \t]*(?:\\)?(?:imagedestroy|curl_close|finfo_close|xml_parser_free)\([^;\n]*\);' '' "${sources[@]}"

  say "images"
  (cd "$PLAYGROUND" && docker compose build app tester && docker compose up -d app worker worker-shots tester)
  (cd "$JUMPHP" && docker build -q -t jumphp/desktop:dev --build-context ext=docker/ext docker/desktop >/dev/null && docker compose build relay)
fi

say "checks"
# every PHP file of both repositories, linted by the new PHP, deprecations as errors
lint() {
  local root="$1"; shift
  (cd "$root" && find "$@" -name '*.php' -not -path '*/vendor/*' -not -path '*/var/*' -print0 2>/dev/null) \
    | docker run --rm -i -v "$root:/w:ro" -w /w "php:$TARGET-cli-bookworm" sh -c \
      'xargs -0 -n 200 -P 4 php -d error_reporting=-1 -l 2>&1 | grep -v "^No syntax errors" | grep . && exit 1 || exit 0'
}
check "php -l (playground)" lint "$PLAYGROUND" src tests docker/tester
check "php -l (JumPHP)" lint "$JUMPHP" engine/src engine/tests engine/bootstrap games skeleton tools
check "playground: PHPUnit" sh -c "cd '$PLAYGROUND' && docker compose exec -T app php -d error_reporting=-1 bin/phpunit --fail-on-deprecation"
check "playground: PHPStan" sh -c "cd '$PLAYGROUND' && docker compose exec -T app vendor/bin/phpstan analyse --no-progress"
check "playground: tester image" sh -c "cd '$PLAYGROUND' && docker compose exec -T tester php -r 'exit(PHP_VERSION_ID >= ${TARGET/./0}00 && extension_loaded(\"sdl\") ? 0 : 1);'"
# bin/jumphp test: lint, phpstan, phpunit (game tests too), the headless demo; a deprecation is a failure
nodeprecation() { local out; out="$("$@" 2>&1)" || { echo "$out" | tail -30; return 1; }; ! echo "$out" | grep -E "Deprecated|DEPRECATED" | head -10 | grep .; }
check "JumPHP: engine" nodeprecation "$JUMPHP/bin/jumphp" test engine
for game in "$JUMPHP"/games/*/; do
  game="$(basename "$game")"
  [ "$(sed -nE 's/^ *runtime: *([a-z]+).*/\1/p' "$JUMPHP/games/$game/config/game.yaml" 2>/dev/null)" = async ] && { echo "    $game: TrueAsync runtime, its own PHP: skipped"; continue; }
  check "JumPHP: $game" nodeprecation "$JUMPHP/bin/jumphp" test "$game"
done

if [ "$CHECK_ONLY" = 0 ] && [ "$SKIP_WASM" = 0 ]; then
  say "WebAssembly engine (PHP $FULL): ~25 min cold"
  check "JumPHP: engine:build" sh -c "cd '$JUMPHP' && bin/jumphp engine:build"
  check "JumPHP: runtime:build" sh -c "cd '$JUMPHP' && bin/jumphp runtime:build"
  check "JumPHP: engine is PHP $TARGET" sh -c "grep -q '\"php\": *\"$TARGET' '$JUMPHP/build/runtime/runtime.json'"
fi

echo
if [ ${#FAILED[@]} -gt 0 ]; then
  warn "${#FAILED[@]} check(s) failed: ${FAILED[*]}"
  echo "Fix them, then: bin/php-upgrade $TARGET --check"
  exit 1
fi
say "PHP $TARGET: every check passed"
cat <<EOF
What is left, by hand (it changes production or publishes):
  1. JumPHP: a new VERSION, a commit, a tag, a release with .build/jumphp-engine.tar.gz (bin/jumphp engine:pack)
     and .build/jumphp-runtime.tar.gz (+ .sha256)
  2. the playground: commit, push, deploy (the site and the tester are rebuilt), then the new engine on it
     (php bin/console app:runtime:install <version>, or JUMPHP_RUNTIMES in deploy/.env)
EOF
