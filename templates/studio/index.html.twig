{% extends 'base.html.twig' %}
{% block title %}{{ 'Mes jeux – studio JumPHP'|trans }}{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}
{% block body %}
<section class="section">
	<div class="wrap">
		<div class="section-head">
			<h1>{{ 'Mes jeux'|trans }}</h1>
			<div class="actions">
				<a class="btn primary" href="{{ path('studio_new') }}">+ {{ 'Nouveau jeu'|trans }}</a>
				<a class="btn" href="{{ path('studio_import') }}">{{ 'Importer un dépôt'|trans }}</a>
				<a class="btn" href="{{ path('studio_mcp') }}">{{ 'Connecter mon Claude (MCP)'|trans }}</a>
			</div>
		</div>
		{% if not app.user.hasMcpToken %}
			<div class="panel" style="margin-bottom: 18px">
				<h2>{{ 'Première fois ?'|trans }}</h2>
				<p class="muted">{{ 'Votre Claude (Claude Code, sur votre machine) écrit le jeu à votre place. Donnez-lui accès au playground une fois pour toutes : <a href="%url%">créer mon jeton MCP</a>. Il lui faut aussi Docker (JumPHP teste et compile tout dans Docker).'|trans({'%url%': path('studio_mcp')|e})|raw }}</p>
			</div>
		{% endif %}
		{% if projects.items %}
			<table class="files">
				{% for project in projects.items %}
					<tr>
						<td><a href="{{ path('studio_project', {slug: project.slug}) }}">{{ project.title }}</a> <span class="faint">/{{ project.slug }}</span></td>
						<td><span class="badge {{ project.status }}">{{ project.status }}</span> {% if project.listed %}<span class="badge">{{ 'annuaire'|trans }}</span>{% endif %}
							{% if pending[project.id] ?? 0 %}<a class="badge creating" href="{{ path('game_comments', {slug: project.slug, section: 'commentaires'}) }}#retours">{{ '%count% à valider'|trans({'%count%': pending[project.id]}) }}</a>{% endif %}</td>
						<td class="size">{{ project.publishedAt ? 'publié le %date%'|trans({'%date%': project.publishedAt|date('d/m/Y H:i')}) : 'pas encore publié'|trans }}</td>
					</tr>
				{% endfor %}
			</table>
			{% include '_pager.html.twig' with {route: 'studio', list: projects} %}
		{% else %}
			<div class="panel empty-state">
				<p>{{ 'Aucun jeu pour l\'instant.'|trans }}</p>
				<a class="btn primary big" href="{{ path('studio_new') }}">{{ 'Créer mon premier jeu'|trans }}</a>
			</div>
		{% endif %}
		{% if drafts %}
			<h2>{{ 'En cours dans l\'éditeur'|trans }}</h2>
			<p class="muted">{{ 'Vos changements pas encore envoyés sur GitHub (faits dans l\'éditeur en ligne, ou importés du bac à sable) : à vous seul.'|trans }}</p>
			<table class="files">
				{% for d in drafts %}
					<tr>
						<td><a href="{{ path('game_edit', {slug: d.project.slug}) }}">{{ d.project.title }}</a> <span class="faint">/{{ d.project.slug }}</span></td>
						<td>{{ '%count% fichier(s) modifié(s)'|trans({'%count%': d.count}) }}</td>
						<td class="size"><a class="btn small" href="{{ path('game_edit', {slug: d.project.slug}) }}">{{ 'Ouvrir l\'éditeur'|trans }}</a></td>
					</tr>
				{% endfor %}
			</table>
		{% endif %}
		{% if shares %}
			<h2>{{ 'Mes liens partagés'|trans }}</h2>
			<table class="files">
				{% for share in shares %}
					{% set url = url('sandbox_shared', {code: share.code}) %}
					<tr>
						<td><a href="{{ url }}">{{ share.title ?: share.project.title }}</a> <span class="faint">{{ share.project.title }} · {{ '%count% vue(s)'|trans({'%count%': share.views}) }}</span></td>
						<td><code id="share-{{ share.code }}">{{ url }}</code> <button class="btn small" type="button" data-copy="#share-{{ share.code }}">{{ 'Copier'|trans }}</button></td>
						<td class="size">{{ share.expiresAt ? 'jusqu\'au %date%'|trans({'%date%': share.expiresAt|date('d/m/Y H:i')}) : 'sans limite'|trans }}
							<form method="post" action="{{ path('sandbox_shared_remove', {code: share.code}) }}" style="display: inline"><input type="hidden" name="_token" value="{{ csrf_token('share-' ~ share.code) }}"><button class="btn small" type="submit">{{ 'Supprimer'|trans }}</button></form></td>
					</tr>
				{% endfor %}
			</table>
		{% endif %}
	</div>
</section>
{% endblock %}
