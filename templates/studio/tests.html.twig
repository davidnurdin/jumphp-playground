{% extends 'base.html.twig' %}
{% block title %}{{ 'Tests de %title% – studio JumPHP'|trans({'%title%': project.title}) }}{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}
{% block body %}
{% set s = run.summary %}
<section class="section">
	<div class="wrap">
		<div class="section-head">
			<h1>{{ 'Tests'|trans }} · {{ project.title }} {% include 'studio/_test_status.html.twig' with {status: run.status} %}</h1>
			<div class="actions">
				<a class="btn" href="{{ path('studio_project', {slug: project.slug}) }}">← {{ 'Projet'|trans }}</a>
				<form method="post" action="{{ path('studio_tests_run', {slug: project.slug}) }}"><input type="hidden" name="_token" value="{{ csrf_token('studio-project-' ~ project.id) }}"><button class="btn primary" type="submit" {{ not run.done ? 'disabled' }}>▶ {{ 'Relancer'|trans }}</button></form>
			</div>
		</div>
		<p class="muted">
			{{ 'Commit'|trans }} <a href="{{ project.repoUrl }}/commit/{{ run.sha }}"><code>{{ run.sha|slice(0, 7) }}</code></a> ·
			{{ run.createdAt|date('d/m/Y H:i:s') }}
			{% if s.tests is defined %} · {{ '%tests% tests, %assertions% assertions, %time% s'|trans({'%tests%': s.tests, '%assertions%': s.assertions, '%time%': s.time}) }}{% endif %}
		</p>
		{% if not run.done %}
			<div class="flash success">{{ run.status == 'queued' ? 'En file d\'attente…'|trans : 'Les tests tournent…'|trans }} {{ 'Cette page se met à jour toute seule.'|trans }}</div>
		{% endif %}
		{# the game tests (GameTestCase), filmed in the sandbox: replayed here, live while they run (assets/app.js) #}
		<div class="films-block" data-films="{{ path('studio_tests_state', {slug: project.slug, id: run.id}) }}"
			data-frame="{{ path('studio_tests_frame', {slug: project.slug, id: run.id, n: '000', frame: '0000'}) }}"
			data-done="{{ run.done ? '1' : '0' }}" data-initial="{{ films|json_encode }}" {{ films is empty and run.done ? 'hidden' }}>
			<h2>🎬 {{ 'Les tests de jeu, filmés'|trans }}</h2>
			<p class="muted">{{ 'Chaque test qui joue le jeu (GameTestCase) est filmé pendant qu\'il tourne : ▶ pour le revoir, le curseur pour aller image par image.'|trans }}</p>
			<div class="films" data-films-list></div>
		</div>
		{% if s.tests is defined %}
			<dl class="stats">
				<div><dt>{{ 'Réussis'|trans }}</dt><dd style="color: var(--green)">{{ s.tests - s.failures - s.errors - s.skipped }}</dd></div>
				<div><dt>{{ 'Échecs'|trans }}</dt><dd style="color: {{ s.failures ? 'var(--red)' : 'inherit' }}">{{ s.failures }}</dd></div>
				<div><dt>{{ 'Erreurs'|trans }}</dt><dd style="color: {{ s.errors ? 'var(--red)' : 'inherit' }}">{{ s.errors }}</dd></div>
				<div><dt>{{ 'Ignorés'|trans }}</dt><dd>{{ s.skipped }}</dd></div>
			</dl>
			<ul class="test-cases">
				{% for case in s.cases %}
					<li class="{{ case.status }}">
						<span class="mark" aria-hidden="true">{{ {passed: '✔', failed: '✘', error: '✘', skipped: '○'}[case.status] }}</span>
						<span><b>{{ case.name }}</b> <span class="faint">{{ case.class }} · {{ case.time }} s</span></span>
						{% if case.message %}<pre class="code">{{ case.message }}</pre>{% endif %}
					</li>
				{% endfor %}
			</ul>
		{% endif %}
		{% if run.done %}
			<h2>{{ 'Sortie de PHPUnit'|trans }}</h2>
			<pre class="code test-output">{{ run.output ?: '—' }}</pre>
		{% endif %}
		{% if runs|length > 1 %}
			<h2>{{ 'Exécutions précédentes'|trans }}</h2>
			{% include 'studio/_test_runs.html.twig' %}
		{% endif %}
	</div>
</section>
{% endblock %}
