<!DOCTYPE html>
{% set lang = app.request.locale %}
<html lang="{{ lang }}">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	{% set page_title = block('title') is defined ? block('title')|trim : '' %}
	<title>{{ page_title ?: ('JumPHP playground : jeux rétro en PHP, jouables dans le navigateur'|trans) }}</title>
	<meta name="description" content="{% block description %}{{ 'Des jeux rétro écrits en PHP avec JumPHP, gratuits et jouables tout de suite dans le navigateur. Créez le vôtre en le décrivant à votre Claude.'|trans }}{% endblock %}">
	{% set page_url = app_url|trim('/', 'right') ~ app.request.pathInfo %}
	{% block canonical %}<link rel="canonical" href="{{ page_url ~ (lang == 'en' ? '?lang=en') }}">{% endblock %}
	{# the page in both languages (the address without ?lang is the French one for search engines), not on the pages kept out of them #}
	{% if 'noindex' not in (block('head') ~ '') %}
	<link rel="alternate" hreflang="fr" href="{{ page_url }}">
	<link rel="alternate" hreflang="en" href="{{ page_url }}?lang=en">
	<link rel="alternate" hreflang="x-default" href="{{ page_url }}">
	{% endif %}
	<meta name="theme-color" content="#0b0e1f">
	<link rel="icon" type="image/png" href="/favicon.png">
	<meta property="og:site_name" content="JumPHP playground">
	<meta property="og:locale" content="{{ lang == 'en' ? 'en_US' : 'fr_FR' }}">
	<meta property="og:locale:alternate" content="{{ lang == 'en' ? 'fr_FR' : 'en_US' }}">
	<meta property="og:type" content="{% block og_type %}website{% endblock %}">
	<meta property="og:title" content="{{ page_title ?: 'JumPHP playground' }}">
	<meta property="og:description" content="{{ block('description')|trim }}">
	<meta property="og:url" content="{{ page_url ~ (lang == 'en' ? '?lang=en') }}">
	<meta property="og:image" content="{% block og_image %}{{ app_url|trim('/', 'right') }}/og.png{% endblock %}">
	{% block og_image_size %}<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">{% endblock %}
	<meta property="og:image:alt" content="{{ page_title ?: 'JumPHP playground' }}">
	<meta name="twitter:card" content="summary_large_image">
	{% block head %}{% endblock %}
	{% block pwa %}{% endblock %}
	{% block javascripts %}{{ importmap('app') }}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
<div class="stripe"></div>
{% block header %}
<header class="top">
	<div class="wrap">
		<a class="logo" href="{{ path('home') }}"><span><b>JUM</b>PHP</span><small>playground</small></a>
		<nav class="nav" aria-label="{{ 'Navigation'|trans }}">
			{% set route = app.request.attributes.get('_route') %}
			<a href="{{ path('home') }}" class="{{ route == 'home' ? 'on' }}">{{ 'Accueil'|trans }}</a>
			<a href="{{ path('games') }}" class="{{ route == 'games' ? 'on' }}">{{ 'Jeux'|trans }}</a>
			<a href="{{ path('categories') }}" class="{{ route in ['categories', 'category'] ? 'on' }}">{{ 'Catégories'|trans }}</a>
			<a href="{{ path('sandbox') }}" class="{{ route starts with 'sandbox' ? 'on' }}">{{ 'Bac à sable'|trans }}</a>
			<a href="{{ path('docs') }}" class="{{ route starts with 'docs' ? 'on' }}">{{ 'Docs'|trans }}</a>
			<a href="{{ path('studio') }}" class="{{ route starts with 'studio' ? 'on' }}">{{ 'Créer'|trans }}</a>
		</nav>
		<form class="search" action="{{ path('search') }}" method="get" role="search">
			<input type="search" name="q" placeholder="{{ 'Chercher un jeu…'|trans }}" aria-label="{{ 'Chercher un jeu'|trans }}" value="{{ app.request.query.get('q') }}">
		</form>
		<div class="me">
			{% if app.user %}
				{% set bell = notifications_count() %}
				<a class="bell{{ bell ? ' on' }}" href="{{ path('studio_notifications') }}" title="{{ bell ? '%count% notification(s)'|trans({'%count%': bell}) : 'Notifications'|trans }}" aria-label="{{ 'Notifications'|trans }}">🔔{% if bell %}<span class="bell-count">{{ bell > 99 ? '99+' : bell }}</span>{% endif %}</a>
				<a href="{{ path('studio') }}" title="{{ 'Mes projets'|trans }}">{% if app.user.avatarUrl %}<img src="{{ app.user.avatarUrl }}&s=60" alt="" width="30" height="30">{% endif %}</a>
				<form action="{{ path('logout') }}" method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="btn small" type="submit">{{ 'Sortir'|trans }}</button></form>
			{% else %}
				<a class="btn small" href="{{ path('connect_github') }}">{{ 'Connexion GitHub'|trans }}</a>
			{% endif %}
		</div>
		{% include '_lang.html.twig' %}
	</div>
</header>
{% endblock %}
{% for type, messages in app.flashes(['success', 'error']) %}
	{% for message in messages %}<div class="wrap"><div class="flash {{ type }}" role="status">{{ message|trans }}</div></div>{% endfor %}
{% endfor %}
<main>{% block body %}{% endblock %}</main>
{% block footer %}
<footer class="bottom">
	<div class="wrap">
		<span>{{ 'Jeux écrits en PHP avec <a href="https://github.com/davidnurdin/jumPhp">JumPHP</a> : le même code sur le bureau et dans le navigateur (WebAssembly).'|trans|raw }}</span>
		<span><a href="{{ path('categories') }}">{{ 'Annuaire'|trans }}</a> · <a href="{{ path('docs') }}">{{ 'Documentation'|trans }}</a> · <a href="{{ path('sandbox') }}">{{ 'Bac à sable'|trans }}</a> · <a href="{{ path('docs_page', {page: 'api'}) }}">API</a> · <a href="{{ path('studio') }}">{{ 'Créer un jeu'|trans }}</a> · <a href="https://github.com/davidnurdin/jumphp-playground">{{ 'Code du site'|trans }}</a></span>
	</div>
</footer>
{% endblock %}
</body>
</html>
