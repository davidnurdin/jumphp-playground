{% extends 'base.html.twig' %}
{% block title %}Connexion indisponible{% endblock %}
{% block body %}
<section class="section"><div class="wrap"><div class="panel">
	<h1>Connexion GitHub pas encore configurée</h1>
	<p class="muted">L'administrateur doit créer une OAuth App GitHub (callback <code>{{ app_url|trim('/', 'right') }}/connect/github/check</code>) et renseigner GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET.</p>
</div></div></section>
{% endblock %}
