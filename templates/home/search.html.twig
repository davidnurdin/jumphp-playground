{% extends 'base.html.twig' %}
{% block title %}{{ q ? 'Recherche « %q% »'|trans({'%q%': q}) : 'Recherche'|trans }} – JumPHP playground{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}
{% block body %}
<section class="section">
	<div class="wrap">
		<h1>{% if q %}{{ 'Résultats pour « %q% »'|trans({'%q%': q}) }}{% else %}{{ 'Chercher un jeu'|trans }}{% endif %}</h1>
		{% if games %}
			<div class="grid">{% for game in games %}{% include '_card.html.twig' %}{% endfor %}</div>
		{% elseif q %}
			<div class="panel empty-state">{{ 'Aucun jeu ne correspond.'|trans }} <a href="{{ path('categories') }}">{{ 'Parcourir les catégories'|trans }}</a></div>
		{% endif %}
	</div>
</section>
{% endblock %}
