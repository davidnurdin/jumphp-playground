<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
	<url><loc>{{ url('home') }}</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
	<url><loc>{{ url('categories') }}</loc><changefreq>weekly</changefreq></url>
{% for category in categories %}
	<url><loc>{{ url('category', {slug: category.slug}) }}</loc><changefreq>daily</changefreq></url>
{% endfor %}
{% for game in games %}
	<url>
		<loc>{{ url('game', {slug: game.slug}) }}</loc>
		<lastmod>{{ game.publishedAt|date('Y-m-d') }}</lastmod>
		<priority>0.8</priority>
		{% if game.hasThumbnail %}<image:image><image:loc>{{ url('game_thumb', {slug: game.slug, sha: game.publishedSha|slice(0, 12)}) }}</image:loc></image:image>{% endif %}
	</url>
{% endfor %}
</urlset>
