{% extends 'base.html.twig' %}
{% block title %}{{ title }} – {{ 'documentation JumPHP'|trans }}{% endblock %}
{% block description %}{{ description ?: 'Créer des jeux rétro en PHP avec JumPHP : toutes les façons, et des tutoriels pas à pas.'|trans }}{% endblock %}
{% block body %}
<section class="section docs">
	<div class="wrap docs-layout">
		<nav class="docs-nav" aria-label="Documentation">
			{% for group, entries in pages %}
				<h2>{{ group|trans }}</h2>
				<ul>
					{% for slug, label in entries %}<li><a href="{{ slug == 'index' ? path('docs') : path('docs_page', {page: slug}) }}" class="{{ slug == page ? 'on' }}"{{ slug == page ? ' aria-current="page"' }}>{{ label|trans }}</a></li>{% endfor %}
				</ul>
			{% endfor %}
			<p><a class="btn small primary" href="{{ path('sandbox') }}">{{ 'Essayer sans compte'|trans }}</a></p>
		</nav>
		<article class="doc">
			{{ html|raw }}
			<nav class="doc-pager" aria-label="Pages">
				{% if previous %}<a href="{{ previous.page == 'index' ? path('docs') : path('docs_page', {page: previous.page}) }}">← {{ previous.title|trans }}</a>{% else %}<span></span>{% endif %}
				{% if next %}<a href="{{ path('docs_page', {page: next.page}) }}">{{ next.title|trans }} →</a>{% endif %}
			</nav>
		</article>
	</div>
</section>
{% endblock %}
