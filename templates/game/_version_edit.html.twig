{# an old version (sha) into the sandbox, or one's online editor #}
<form method="post" action="{{ path('game_version_edit', {slug: project.slug, sha: sha, to: 'bac-a-sable'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('version-' ~ sha) }}"><button class="btn small" type="submit" title="{{ 'Vos changements de ce jeu dans le bac à sable sont remplacés par cette version.'|trans }}">✏️ {{ 'Bac à sable'|trans }}</button></form>
<form method="post" action="{{ path('game_version_edit', {slug: project.slug, sha: sha, to: 'editeur'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('version-' ~ sha) }}"><button class="btn small" type="submit" title="{{ project.isOwnedBy(app.user) ? 'Dans votre éditeur : « Envoyer sur GitHub » remet cette version en ligne.'|trans : 'Dans votre éditeur : « Forker pour garder » en fait votre jeu.'|trans }}">{{ project.isOwnedBy(app.user) ? '↩ Restaurer'|trans : '🍴 Éditer / forker'|trans }}</button></form>
