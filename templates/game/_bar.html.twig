{# the portal's bar over a game's site / player: who made it, and what one can do with it #}
<div class="gamebar">
	<div class="wrap">
		<h1><a href="{{ path('game', {slug: project.slug}) }}" style="color: inherit">{{ project.title }}</a></h1>
		<span class="by">{{ 'par %author%'|trans({'%author%': '<a href="' ~ path('profile', {login: project.owner.login})|e ~ '">' ~ project.owner.login|e ~ '</a>'})|raw }} · <a href="{{ path('category', {slug: project.category.slug}) }}">{{ project.category.name|trans }}</a></span>
		{% include 'game/_rate.html.twig' %}
		<div class="actions">
			{% if mode != 'play' %}<a class="btn small primary" href="{{ path('game_play', {slug: project.slug}) }}">▶ {{ 'Jouer'|trans }}</a>{% endif %}
			{% if mode == 'play' %}<button class="btn small" type="button" data-fullscreen>⛶ {{ 'Plein écran'|trans }}</button>{% endif %}
			{% if mode in ['site', 'play', 'source', 'edit'] %}<a class="btn small" href="{{ path('game_comments', {slug: project.slug, section: 'commentaires'}) }}#retours" title="{{ 'Commentaires, idées et problèmes'|trans }}">💬 {{ 'Avis'|trans }}{% if project.commentCount %} <span class="faint">{{ project.commentCount }}</span>{% endif %}</a>{% endif %}
			{% include 'game/_install.html.twig' %}
			{% include 'game/_share.html.twig' %}
			<a class="btn small" href="{{ path('game_source', {slug: project.slug}) }}">{{ 'Sources'|trans }}</a>
			<a class="btn small" href="{{ path('game_edit', {slug: project.slug}) }}">{{ 'Éditer'|trans }}</a>
			<a class="btn small" href="{{ project.repoUrl }}" rel="noopener">GitHub</a>
			{% if project.isOwnedBy(app.user) %}<a class="btn small" href="{{ path('studio_project', {slug: project.slug}) }}">{{ 'Réglages'|trans }}</a>{% endif %}
		</div>
	</div>
</div>
