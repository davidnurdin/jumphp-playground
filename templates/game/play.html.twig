{% extends 'base.html.twig' %}
{% block title %}{{ 'Jouer à %title%'|trans({'%title%': project.title}) }} – JumPHP playground{% endblock %}
{% block description %}{{ project.descriptionIn(app.request.locale) ?: project.title }}{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('game', {slug: project.slug}) }}">{% endblock %}
{% block pwa %}{% include 'game/_pwa_head.html.twig' %}{% endblock %}
{% block body_class %}full{% endblock %}
{% block body %}
{% include 'game/_bar.html.twig' with {mode: 'play'} %}
<iframe class="frame" src="{{ frame }}" title="{{ project.title }}" data-game-frame data-quit="{{ path('game', {slug: project.slug}) }}" allow="fullscreen; gamepad; autoplay; clipboard-write; screen-wake-lock" allowfullscreen></iframe>
{% endblock %}
