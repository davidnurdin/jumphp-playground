{% extends 'base.html.twig' %}
{% set site = project.site %}
{# the game's own site speaks one language: its title and description only in it #}
{% set site_speaks = site and (site.lang ?? '') ? site.lang|slice(0, 2) == app.request.locale : app.request.locale == 'fr' %}
{% block title %}{{ site and site.title and site_speaks ? site.title : '%title% – jeu gratuit en ligne (%category%)'|trans({'%title%': project.title, '%category%': project.category.name|trans|lower}) }}{% endblock %}
{% block description %}{{ project.hasDescriptionIn(app.request.locale) ? project.descriptionIn(app.request.locale) : site and site.description and site_speaks ? site.description : (project.description ?: '%title%, un jeu écrit en PHP avec JumPHP, à jouer gratuitement dans le navigateur.'|trans({'%title%': project.title})) }}{% endblock %}
{% block og_type %}video.game{% endblock %}
{# shared: the picture the game's site made for it, else a card made from its picture (1200 x 630, App\Service\ShareCard) #}
{% block og_image %}{% if site and site.image %}{{ url('game', {slug: project.slug}) ~ '/' ~ site.image }}{% elseif project.hasThumbnail %}{{ url('game_share', {slug: project.slug, sha: project.publishedSha|slice(0, 12), lang: app.request.locale}) }}{% else %}{{ parent() }}{% endif %}{% endblock %}
{% block og_image_size %}{% if not (site and site.image) %}{{ parent() }}{% endif %}{% endblock %}
{% block head %}{% if project.publishedSha %}{% include 'game/_jsonld.html.twig' %}{% endif %}{% if not project.listed %}<meta name="robots" content="noindex">{% endif %}{% endblock %}
{% block pwa %}{% include 'game/_pwa_head.html.twig' %}{% endblock %}
{% block body_class %}{{ frame ? 'full' }}{% endblock %}
{% block body %}
{% if not project.publishedSha %}
	<section class="section"><div class="wrap">
		<h1>{{ project.title }}</h1>
		<div class="panel">
			<p><span class="badge {{ project.status }}">{{ project.status }}</span> {{ 'Ce jeu n\'est pas encore publié (vous seul voyez cette page).'|trans }}</p>
			{% if project.statusMessage %}<pre class="code">{{ project.statusMessage|trans }}</pre>{% endif %}
			<a class="btn" href="{{ path('studio_project', {slug: project.slug}) }}">{{ 'Voir le projet'|trans }}</a>
		</div>
	</div></section>
{% elseif frame %}
	{% include 'game/_bar.html.twig' with {mode: 'site'} %}
	<iframe class="frame" src="{{ frame }}" title="{{ project.title }}" data-game-frame allow="fullscreen; gamepad; autoplay; clipboard-write; screen-wake-lock" allowfullscreen></iframe>
{% else %}
	{% include 'game/_bar.html.twig' with {mode: 'page'} %}
	<div class="wrap">
		<section class="game-hero">
			<a class="thumb" href="{{ path('game_play', {slug: project.slug}) }}" aria-label="{{ 'Jouer à %title%'|trans({'%title%': project.title}) }}">
				{% if project.hasThumbnail %}<img src="{{ path('game_thumb', {slug: project.slug, sha: project.publishedSha|slice(0, 12)}) }}" alt="{{ project.title }}" width="640" height="360">
				{% else %}<div class="placeholder" style="--h: {{ (project.slug|length * 37 + project.id * 53) % 360 }}">{{ project.title }}</div>{% endif %}
			</a>
			<div>
				<span class="badge">{{ project.category.name|trans }}</span>
				<h2 style="font-size: clamp(26px, 4vw, 38px); margin-top: 10px">{{ project.title }}</h2>
				{% if project.descriptionIn(app.request.locale) %}<p class="muted" style="font-size: 18px">{{ project.descriptionIn(app.request.locale) }}</p>{% endif %}
				<p><a class="btn primary big" href="{{ path('game_play', {slug: project.slug}) }}">▶ {{ 'Jouer'|trans }}</a></p>
				<dl class="facts">
					{% if project.gameInfo.controls ?? null %}<dt>{{ 'Commandes'|trans }}</dt><dd>{{ project.gameInfo.controls }}</dd>{% endif %}
					<dt>{{ 'Auteur'|trans }}</dt><dd><a href="{{ path('profile', {login: project.owner.login}) }}">{{ project.owner.displayName }}</a></dd>
					<dt>{{ 'Mis à jour'|trans }}</dt><dd>{{ project.publishedAt|date('d/m/Y') }}</dd>
					{% if project.forkOf %}<dt>{{ 'Fork de'|trans }}</dt><dd><a href="{{ path('game', {slug: project.forkOf.slug}) }}">{{ project.forkOf.title }}</a></dd>{% endif %}
					<dt>{{ 'Moteur'|trans }}</dt><dd>JumPHP {{ project.engineVersion }} ({{ 'PHP en WebAssembly'|trans }})</dd>
				</dl>
			</div>
		</section>
		{% if fork_slug %}
		<section class="panel">
			<h2>{{ 'Faire votre version'|trans }}</h2>
			<p class="muted">{{ 'Un fork copie ce jeu dans votre compte GitHub et le publie ici sous un autre nom : modifiez-le dans l\'éditeur ou avec votre Claude.'|trans }}</p>
			<form class="actions" method="post" action="{{ path('game_fork', {slug: project.slug}) }}">
				<input type="hidden" name="_token" value="{{ csrf_token('fork-' ~ project.id) }}">
				<input name="slug" value="{{ fork_slug }}" aria-label="{{ 'Nom de votre version'|trans }}" style="max-width: 300px">
				<button class="btn" type="submit">{{ 'Forker'|trans }}</button>
			</form>
		</section>
		{% endif %}
		<div class="section">{% include 'game/_comments.html.twig' with {from: 'page'} %}</div>
		{% if others %}
		<section class="section">
			<div class="section-head"><h2>{{ 'Dans la même catégorie'|trans }}</h2><a href="{{ path('category', {slug: project.category.slug}) }}">{{ 'Tout voir'|trans }} →</a></div>
			<div class="grid">{% for game in others|slice(0, 6) %}{% include '_card.html.twig' %}{% endfor %}</div>
		</section>
		{% endif %}
	</div>
{% endif %}
{% endblock %}
