{# the two languages, top right: a flag switches the page (?lang=, remembered by App\EventSubscriber\Language) #}
{% set lang = app.request.locale %}
<div class="lang" role="group" aria-label="Langue / Language">
	<a href="{{ app.request.pathInfo }}?{{ app.request.query.all|merge({lang: 'fr'})|url_encode }}" class="{{ lang == 'fr' ? 'on' }}" hreflang="fr" lang="fr" title="Français" aria-label="Français"{% if lang == 'fr' %} aria-current="true"{% endif %}>
		<svg viewBox="0 0 3 2" width="24" height="16" aria-hidden="true"><rect width="1" height="2" fill="#0055a4"/><rect x="1" width="1" height="2" fill="#fff"/><rect x="2" width="1" height="2" fill="#ef4135"/></svg>
	</a>
	<a href="{{ app.request.pathInfo }}?{{ app.request.query.all|merge({lang: 'en'})|url_encode }}" class="{{ lang == 'en' ? 'on' }}" hreflang="en" lang="en" title="English" aria-label="English"{% if lang == 'en' %} aria-current="true"{% endif %}>
		<svg viewBox="0 0 60 30" width="24" height="16" preserveAspectRatio="none" aria-hidden="true"><clipPath id="uk-t"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/></clipPath><path d="M0,0 v30 h60 v-30 z" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#uk-t)" stroke="#C8102E" stroke-width="4"/><path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/><path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/></svg>
	</a>
</div>
