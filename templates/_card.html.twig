{# a game in a grid: picture (or its initials on a colour of its own), title, category, author #}
<a class="card" href="{{ path('game', {slug: game.slug}) }}">
	<div class="thumb">
		{% if game.hasThumbnail %}
			<img src="{{ path('game_thumb', {slug: game.slug, sha: game.publishedSha|slice(0, 12)}) }}" alt="{{ game.title }}" loading="lazy" width="640" height="360">
		{% else %}
			<div class="placeholder" style="--h: {{ (game.slug|length * 37 + game.id * 53) % 360 }}">{{ game.title }}</div>
		{% endif %}
	</div>
	<div class="body">
		<span class="cat">{{ game.category.name }}</span>
		<h3>{{ game.title }}</h3>
		{% if game.description %}<p>{{ game.description }}</p>{% endif %}
		<div class="meta">
			{% if game.owner.avatarUrl %}<img src="{{ game.owner.avatarUrl }}&s=40" alt="" width="20" height="20" loading="lazy">{% endif %}
			<span>{{ game.owner.login }}</span>
			{% if game.rating %}<span class="stars-mini" title="{{ game.rating }} / 5 ({{ game.ratingCount }} vote{{ game.ratingCount > 1 ? 's' }})">★ {{ game.rating|number_format(1, ',') }}</span>{% endif %}
			{% if game.plays %}<span class="faint">· {{ game.plays }} partie{{ game.plays > 1 ? 's' }}</span>{% endif %}
		</div>
	</div>
</a>
