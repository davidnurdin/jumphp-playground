# Copy to deploy/.env on the server and fill in (never commit deploy/.env).
APP_HOST=playground.example.org
PLAY_HOST=play.playground.example.org
# optional: the previous names of the two sites after a move, redirected (301) to the ones above, like
# www.<APP_HOST>; their DNS must still point here
#OLD_APP_HOST=playground.old.example
#OLD_PLAY_HOST=play.playground.old.example
# openssl rand -hex 32
APP_SECRET=
# openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=
# the key that encrypts the users' GitHub tokens: php -r 'echo base64_encode(random_bytes(32));'
TOKEN_KEY=
# a GitHub OAuth App: homepage https://<APP_HOST>, callback https://<APP_HOST>/connect/github/check
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# the JumPHP engines to serve (installed from the GitHub releases at start)
JUMPHP_RUNTIMES=0.2.0
TRAEFIK_NETWORK=traefik_web
TRAEFIK_ENTRYPOINT=secure
TRAEFIK_HTTP_ENTRYPOINT=insecure
