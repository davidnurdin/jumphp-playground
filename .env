# Defaults (development). Production: the server's .env (deploy/README.md); never commit secrets.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev-only-secret-change-me
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# the portal and the isolated games origin (game code never runs on the portal's origin)
APP_URL=http://jumphp.localhost:8000
APP_HOST=jumphp.localhost
PLAY_URL=http://play.jumphp.localhost:8000
PLAY_HOST=play.jumphp.localhost
DEFAULT_URI=http://jumphp.localhost:8000

# GitHub OAuth App (Settings > Developer settings > OAuth Apps): callback <APP_URL>/connect/github/check
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub tokens are stored encrypted with this key (32 bytes, base64): php -r 'echo base64_encode(random_bytes(32));'
TOKEN_KEY=ZGV2LW9ubHkta2V5LWRldi1vbmx5LWtleS1kZXYtISE=

# the JumPHP repository new projects start from, and the shared engines served in /engine/<version>/
JUMPHP_REPO=https://github.com/davidnurdin/jumPhp.git
JUMPHP_RUNTIMES=0.2.0

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
SHOTS_TRANSPORT_DSN=doctrine://default?queue_name=shots&auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
LOCK_DSN=flock:///app/var/storage/locks
###< symfony/lock ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://playground:playground@db:3306/playground?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

# the headless Chrome that photographs the games without a picture (shooter/server.cjs)
SHOOTER_URL=http://app:3000
